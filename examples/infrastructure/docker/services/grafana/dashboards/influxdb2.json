{
    "annotations": { "list": [] },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "title": "About this dashboard",
            "type": "text",
            "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
            "options": {
                "mode": "markdown",
                "content": "This dashboard reads from **InfluxDB 2.x** (bucket `app`), written to by the `influxdb_v2` collector (`Beberlei\\Metrics\\Collector\\InfluxDbV2`), through the official `influxdata/influxdb-client-php` client. Every metric is written as one point per measurement (named after the metric, e.g. `homepage.visits`), with its value in a field called `value`. Queries use Flux, InfluxDB 2.x's query language. The `$measurement` variable above is populated with `schema.measurements()`, so it lists every metric name ever sent, including custom ones from the form."
            }
        },
        {
            "title": "homepage.visits (guaranteed to exist after the first page load)",
            "type": "timeseries",
            "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
            "datasource": { "type": "influxdb", "uid": "influxdb2-metrics" },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi" }
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "influxdb", "uid": "influxdb2-metrics" },
                    "query": "from(bucket: \"app\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"homepage.visits\")\n  |> filter(fn: (r) => r._field == \"value\")"
                }
            ]
        },
        {
            "title": "Explore: $measurement",
            "type": "timeseries",
            "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
            "datasource": { "type": "influxdb", "uid": "influxdb2-metrics" },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi" }
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "influxdb", "uid": "influxdb2-metrics" },
                    "query": "from(bucket: \"app\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${measurement}\")\n  |> filter(fn: (r) => r._field == \"value\")"
                }
            ]
        }
    ],
    "refresh": "10s",
    "schemaVersion": 39,
    "tags": ["metrics-demo", "influxdb"],
    "templating": {
        "list": [
            {
                "name": "measurement",
                "type": "query",
                "label": "Metric (measurement)",
                "datasource": { "type": "influxdb", "uid": "influxdb2-metrics" },
                "query": "import \"influxdata/influxdb/schema\"\nschema.measurements(bucket: \"app\")",
                "refresh": 2,
                "sort": 1,
                "includeAll": false,
                "multi": false,
                "current": { "text": "homepage.visits", "value": "homepage.visits" }
            }
        ]
    },
