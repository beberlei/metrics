<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}beberlei/metrics demo{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        <nav class="navbar navbar-expand navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('homepage') }}">beberlei/metrics demo</a>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" href="https://grafana.{{ app.request.host }}" target="_blank" rel="noopener">
                        Grafana ↗
                    </a>
                    <a class="nav-link" href="https://github.com/beberlei/metrics" target="_blank" rel="noopener">
                        GitHub ↗
                    </a>
                </div>
            </div>
        </nav>

        <main class="container py-4 flex-grow-1">
            {% for label, messages in app.flashes(['success', 'danger']) %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="border-top py-3 text-center text-body-secondary small">
            Demo application for the <a href="https://github.com/beberlei/metrics">beberlei/metrics</a> library.
        </footer>
    </body>
</html>
